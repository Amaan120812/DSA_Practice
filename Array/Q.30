class Solution:
    def isSubset(self, arr1, arr2):
        used = [False] * len(arr1)

        for x in arr2:
            found = False
            for i in range(len(arr1)):
                if arr1[i] == x and not used[i]:
                    used[i] = True
                    found = True
                    break
            if not found:
                return False

        return True
